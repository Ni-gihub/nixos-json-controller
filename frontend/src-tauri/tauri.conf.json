{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "nxc-app",
  "version": "0.1.0",
  "identifier": "io.github.ni-gihub.nxc-app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "nxc App Store",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "base-uri": "'self'",
        "connect-src": "ipc: http://ipc.localhost https://api.iconify.design",
        "font-src": "'self'",
        "form-action": "'self'",
        "img-src": "'self' asset: http://asset.localhost data:",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      },
      "devCsp": {
        "default-src": "'self' customprotocol: asset: http://localhost:5173",
        "base-uri": "'self'",
        "connect-src": "ipc: http://ipc.localhost https://api.iconify.design http://localhost:5173 ws://localhost:5173",
        "font-src": "'self'",
        "form-action": "'self'",
        "img-src": "'self' asset: http://asset.localhost data:",
        "object-src": "'none'",
        "script-src": "'self' http://localhost:5173",
        "style-src": "'self' 'unsafe-inline' http://localhost:5173"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
